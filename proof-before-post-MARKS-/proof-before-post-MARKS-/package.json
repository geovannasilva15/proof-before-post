{
  "name": "proof-before-post",
  "version": "1.0.0",
  "private": true,
  "description": "A bilingual, human-centered media literacy experience for reviewing evidence before publishing.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run type-check && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
